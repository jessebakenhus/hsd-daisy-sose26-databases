-- Aufgabe 1
--
-- Erstellen Sie eine Abfrage, um alle Daten der Tabelle Movies anzuzeigen. Trennen Sie die Spalten durch ein Komma voneinander. Nennen Sie die Spalte CSV_OUTPUT. Nutzen Sie dafür die String-Verkettung.
-- ------------------------------------------------------------
SELECT CONCAT_WS(',',
    movie_id,
    title,
    releasedate,
    genre_id,
    budget,
    openingweek,
    profit,
    runtime,
    certificate,
    sequelof,
    distribution
) AS CSV_OUTPUT
FROM movies;
