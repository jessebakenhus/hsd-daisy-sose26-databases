-- Aufgabe 2a
-- Zeigen Sie Titel und Genre_ID aller Filme der Genre_IDs 1 und 3 in alphabetischer Reihenfolge nach Titel an.
-- ------------------------------------------------------------
SELECT title, genre_id
FROM movies
WHERE genre_id IN (1, 3)
ORDER BY title;
