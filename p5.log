-- b) ohne Subquery
SELECT m.title, m.profit
FROM movies m
    INNER JOIN movies a ON a.genre_id = 4
WHERE m.profit > a.profit
GROUP BY m.title, m.profit
HAVING m.profit > MAX(a.profit)
ORDER BY m.profit DESC;
